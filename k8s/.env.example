# ──────────────────────────────────────────────────────────────────────────────
# LogAI Engine – Kubernetes Environment Variables
# Copy this file to `k8s/.env` and edit with your cluster settings.
# When you run `kubectl apply -k k8s/`, Kubernetes automatically takes ALL
# values from this file (ports, images, storage sizes, and credentials).
# ──────────────────────────────────────────────────────────────────────────────

# ── Container Image ───────────────────────────────────────────────────────────
# Registry path for the LogAI engine image
LOGAI_IMAGE=logai-engine:latest

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# In-cluster ES service URL or external endpoint (comma-separated for multi-node)
LOGAI_ES_HOSTS=http://elasticsearch.default.svc.cluster.local:9200
LOGAI_ES_USER=
LOGAI_ES_PASSWORD=

# ── Prometheus metrics HTTP server ────────────────────────────────────────────
LOGAI_METRICS_PORT=9108
LOGAI_METRICS_HOST=0.0.0.0

# ── Storage & Paths ───────────────────────────────────────────────────────────
# Engine writes templates to /app/data, Web UI reads from the exact same dir
LOGAI_STORAGE_BASE_DIR=/app/data
# Persists Hugging Face sentence-transformers embedding model weights (~90MB)
HF_HOME=/app/hf-cache
# Hugging Face sentence-transformers model name or local directory path
# LOGAI_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
# Storage sizes for persistent volume claims
LOGAI_DATA_STORAGE_SIZE=10Gi
LOGAI_HF_STORAGE_SIZE=5Gi

# ── Template Explorer Web UI ─────────────────────────────────────────────────
LOGAI_WEB_PORT=5555
LOGAI_WEB_HOST=0.0.0.0
