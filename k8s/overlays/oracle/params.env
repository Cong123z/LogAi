# Non-secret settings for the Oracle Cloud cluster, committed to Git.
# Credentials (LOGAI_ES_USER, LOGAI_ES_PASSWORD, LOGAI_EMBEDDING_API_KEY,
# LOGAI_LLM_API_KEY) go in the Secret `logai-env`, created by hand.
# A key also present in that Secret is overridden by the Secret.
# Edit a value and merge: the ConfigMap name changes, so the pods restart.

# Defaults only: a connection saved on the web Data sources page overrides LOGAI_ES_*.
LOGAI_ES_HOSTS=http://elasticsearch.logging.svc:9200
LOGAI_ES_INDEX=hdfs
# false skips TLS certificate checks (self-signed Elasticsearch 8).
LOGAI_ES_VERIFY_CERTS=true

LOGAI_METRICS_PORT=9108
LOGAI_METRICS_HOST=0.0.0.0

LOGAI_STORAGE_BASE_DIR=/app/data
LOGAI_DOCUMENTATION_CORPUS_PATH=/app/data/documentation_corpus.json

# Empty endpoint disables the LLM feature.
LOGAI_LLM_ENDPOINT=
LOGAI_LLM_MODEL=

LOGAI_WEB_PORT=5555
LOGAI_WEB_HOST=0.0.0.0
