# ──────────────────────────────────────────────────────────────────────────────
# LogAI Engine – Environment Variables
# Copy this file to `.env` and adjust values for your environment.
# docker-compose reads `.env` automatically; for bare-metal runs you can
# `export $(grep -v '^#' .env | xargs)` or use a tool like direnv.
# ──────────────────────────────────────────────────────────────────────────────

# ── Elasticsearch ─────────────────────────────────────────────────────────────
LOGAI_ES_HOSTS=http://elasticsearch:9200
LOGAI_ES_USER=
LOGAI_ES_PASSWORD=

# ── Prometheus metrics HTTP server ────────────────────────────────────────────
LOGAI_METRICS_PORT=9108
LOGAI_METRICS_HOST=0.0.0.0

# ── Data storage & Models ─────────────────────────────────────────────────────
# Where the engine writes templates, models, checkpoints.
# The web UI reads from the same directory by default.
LOGAI_STORAGE_BASE_DIR=/app/data
LOGAI_DOCUMENTATION_CORPUS_PATH=/app/data/documentation_corpus.json
# Hugging Face sentence-transformers model name or local directory path
# LOGAI_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2

# ── Template Explorer Web UI ─────────────────────────────────────────────────
LOGAI_WEB_PORT=5555
LOGAI_WEB_HOST=0.0.0.0
# LOGAI_WEB_DATA_DIR=        # Optional: override to read from a different dir than the engine writes to

# ── Grafana (only used with docker-compose --profile ui) ──────────────────────
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_PASSWORD=admin

# ── Docker network ────────────────────────────────────────────────────────────
# Name of the external Docker network. Must exist before running docker compose.
# Create it with: docker network create <name>
LOGAI_NETWORK=aiops-net
