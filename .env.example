
# ── Elasticsearch ─────────────────────────────────────────────────────────────
LOGAI_ES_HOSTS=http://elasticsearch:9200
LOGAI_ES_INDEX=app-logs-*
LOGAI_ES_USER=
LOGAI_ES_PASSWORD=

# ── Prometheus metrics HTTP server ────────────────────────────────────────────
LOGAI_METRICS_PORT=9108
LOGAI_METRICS_HOST=0.0.0.0

# ── Data storage ──────────────────────────────────────────────────────────────
# Where the engine writes templates, models, checkpoints.
LOGAI_STORAGE_BASE_DIR=/app/data

# ── Remote BGE-M3 embeddings ─────────────────────────────────────────────────
LOGAI_EMBEDDING_ENDPOINT=http://bge-m3:8080/v1/embeddings
LOGAI_EMBEDDING_API_FORMAT=openai
LOGAI_EMBEDDING_API_KEY=
LOGAI_EMBEDDING_MODEL=BAAI/bge-m3
LOGAI_EMBEDDING_DIMENSION=1024
LOGAI_EMBEDDING_BATCH_SIZE=64
LOGAI_EMBEDDING_TIMEOUT_SECONDS=60
LOGAI_EMBEDDING_MAX_RETRIES=3
LOGAI_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5

# ── Template Explorer Web UI ─────────────────────────────────────────────────
LOGAI_WEB_PORT=5555
LOGAI_WEB_HOST=0.0.0.0

# ── Grafana (only used with docker-compose --profile ui) ──────────────────────
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_PASSWORD=admin

# ── Docker network ────────────────────────────────────────────────────────────
# Name of the external Docker network. Must exist before running docker compose.
# Create it with: docker network create <name>
LOGAI_NETWORK=aiops-net
